# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same names in Vercel → Settings →
# Environment Variables for production. .env* is gitignored — never commit a key.
# The site runs with NONE of these set; each one only switches something on.
# ─────────────────────────────────────────────────────────────────────────────

# EMAIL CAPTURE (Buttondown). Set ONE of the two.
#   Preferred — the v1 API key (Buttondown → Settings → Programming/API):
BUTTONDOWN_API_KEY=
#   Fallback — just the public username, no key (uses the embed endpoint):
BUTTONDOWN_USERNAME=

# LEDGER READS (optional). Only raises the GitHub API rate limit; the ledger is
# public and reads fine without it. A fine-grained token with NO scopes is enough.
GITHUB_TOKEN=

# SUBSTACK (optional). Comma-separated feed URLs; overrides the defaults in
# config/site.js. Example:
# SUBSTACK_FEEDS=https://deviationsystems.substack.com/feed
SUBSTACK_FEEDS=
